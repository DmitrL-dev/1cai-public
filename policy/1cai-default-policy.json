{
  "version": "2026-06-15",
  "rules": [
    {
      "id": "impact.max_risk.high",
      "domain": "impact",
      "severity": "high",
      "decision": "fail",
      "description": "High maximum risk blocks uncontrolled change delivery.",
      "when": {"field": "risk_summary.max_risk", "op": ">=", "value": 80},
      "requires_approval": true
    },
    {
      "id": "impact.blast_radius.large",
      "domain": "impact",
      "severity": "high",
      "decision": "fail",
      "description": "Large blast radius requires explicit release governance.",
      "when": {"field": "risk_summary.total_impact_edges", "op": ">=", "value": 300},
      "requires_approval": true
    },
    {
      "id": "tests.coverage.gap",
      "domain": "tests",
      "severity": "high",
      "decision": "fail",
      "description": "A changed scope with test coverage gaps cannot pass the release gate.",
      "when": {"field": "test_matrix.summary.gaps", "op": ">", "value": 0},
      "requires_approval": true
    },
    {
      "id": "tests.evidence.failed_run",
      "domain": "tests",
      "severity": "high",
      "decision": "fail",
      "description": "A change set with failed stored test evidence cannot pass the release gate.",
      "when": {"field": "test_evidence.failed_runs", "op": ">", "value": 0},
      "requires_approval": true
    },
    {
      "id": "release.decision.fail",
      "domain": "release",
      "severity": "high",
      "decision": "fail",
      "description": "Release-readiness fail blocks release without waiver.",
      "when": {"field": "release_readiness.decision.status", "op": "==", "value": "fail"},
      "requires_approval": true
    },
    {
      "id": "security.findings.high",
      "domain": "security",
      "severity": "high",
      "decision": "fail",
      "description": "High-severity security findings require owner approval or remediation.",
      "when": {"field": "security.summary.high", "op": ">", "value": 0},
      "requires_approval": true
    },
    {
      "id": "standards.findings.medium",
      "domain": "standards",
      "severity": "medium",
      "decision": "warn",
      "description": "Medium-severity standards findings should be reviewed before merge.",
      "when": {"field": "standards.summary.medium", "op": ">", "value": 0},
      "requires_approval": false
    }
  ]
}
