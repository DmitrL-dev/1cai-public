// Собственные данные для проверки миграции схемы; MIT.
Функция ОжидаемыеДанные()
    Данные = Новый Соответствие;
    Данные.Вставить("R1", "Рентген-α-東京");
    Данные.Вставить("R2", "");
    Данные.Вставить("R3", "01234567890123456789012345678901");
    Возврат Данные;
КонецФункции

Процедура СоздатьДанные() Экспорт
    ЮТест.ОжидаетЧто(ТранзакцияАктивна()).Равно(Ложь);
    Выборка = Справочники.Products.Выбрать();
    ЮТест.ОжидаетЧто(Выборка.Следующий()).Равно(Ложь);
    Для Каждого Пара Из ОжидаемыеДанные() Цикл
        Объект = Справочники.Products.СоздатьЭлемент();
        Объект.Код = Пара.Ключ + "0000000";
        Объект["Article"] = Пара.Значение;
        Объект.Записать();
        Идентификатор = СтрЗаменить(Строка(Объект.Ссылка.УникальныйИдентификатор()), "-", "");
        // Наименование в фикстуре ограничено 25 знаками, код — 9.
        // Все 32 hex-знака исходной ссылки хранятся как 25 + 7, без усечения.
        Объект.Наименование = Лев(Идентификатор, 25);
        Объект.Код = Пара.Ключ + Прав(Идентификатор, 7);
        Объект.Записать();
    КонецЦикла;
    ПроверитьДанные("Article");
КонецПроцедуры

Процедура ПроверитьДанные(ИмяРеквизита) Экспорт
    ЮТест.ОжидаетЧто(Метаданные.Справочники.Products.Реквизиты.Найти(ИмяРеквизита) = Неопределено).Равно(Ложь);
    СтароеИмя = ?(ИмяРеквизита = "SKU", "Article", "SKU");
    ЮТест.ОжидаетЧто(Метаданные.Справочники.Products.Реквизиты.Найти(СтароеИмя) = Неопределено).Равно(Истина);
    Данные = ОжидаемыеДанные();
    Выборка = Справочники.Products.Выбрать();
    Количество = 0;
    Пока Выборка.Следующий() Цикл
        Объект = Выборка.Ссылка.ПолучитьОбъект();
        Ключ = Лев(Объект.Код, 2);
        Ожидание = Данные.Получить(Ключ);
        ЮТест.ОжидаетЧто(Ожидание = Неопределено).Равно(Ложь);
        ЮТест.ОжидаетЧто(Объект[ИмяРеквизита]).Равно(Ожидание);
        Идентификатор = СтрЗаменить(Строка(Объект.Ссылка.УникальныйИдентификатор()), "-", "");
        ЮТест.ОжидаетЧто(Объект.Наименование + Прав(Объект.Код, 7)).Равно(Идентификатор);
        Данные.Удалить(Ключ);
        Количество = Количество + 1;
    КонецЦикла;
    ЮТест.ОжидаетЧто(Количество).Равно(3);
    ЮТест.ОжидаетЧто(Данные.Количество()).Равно(0);
КонецПроцедуры
